    {
      "id": 402,
      "title": "Lap Times \u2014 ${driver_acronym} with 3-lap rolling avg",
      "description": "Per-driver median clean-lap pace with the 5-95th percentile range as a secondary metric. Median is true race pace (immune to outliers); spread quantifies consistency. Sorted fastest median to slowest.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "format": 0,
          "queryType": "sql",
          "rawSql": "SELECT date_start AS time,\n              lap_number,\n              round(lap_duration, 3) AS lap_time,\n              round(avg(lap_duration) OVER (ORDER BY lap_number ROWS BETWEEN 2 PRECEDING AND CURRENT ROW), 3) AS rolling_avg_3\n         FROM default.fct_laps\n         WHERE session_key = ${session_key}\n           AND name_acronym = '${driver_acronym}'\n           AND lap_duration IS NOT NULL AND is_pit_out_lap = 0\n         ORDER BY time",
          "refId": "A",
          "meta": {
            "builderOptions": {
              "queryType": "table",
              "database": "default",
              "table": "fct_laps"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": true
          },
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "rolling_avg_3"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 501,
      "title": "Sector Breakdown \u2014 ${driver_acronym} per Lap",
      "description": "How often each driver was the fastest in each sector across the race. Drivers who win sectors but rarely the lap reveal where their car excels (e.g. high-speed S1 vs slow corner S3).",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "format": 0,
          "queryType": "sql",
          "rawSql": "SELECT date_start AS time,\n              lap_number,\n              round(duration_sector_1, 3) AS sector_1,\n              round(duration_sector_2, 3) AS sector_2,\n              round(duration_sector_3, 3) AS sector_3\n         FROM default.fct_laps\n         WHERE session_key = ${session_key}\n           AND name_acronym = '${driver_acronym}'\n           AND duration_sector_1 > 0 AND duration_sector_2 > 0 AND duration_sector_3 > 0\n           AND is_pit_out_lap = 0\n         ORDER BY time",
          "refId": "A",
          "meta": {
            "builderOptions": {
              "queryType": "table",
              "database": "default",
              "table": "fct_laps"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 502,
      "title": "Speed Trap \u2014 ${driver_acronym} per Lap",
      "description": "Highest end-of-straight speed reached by each driver. Indicates straight-line efficiency: low downforce setups, slipstream usage, DRS effectiveness, and engine power.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 36,
