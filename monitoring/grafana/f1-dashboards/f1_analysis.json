    {
      "id": 101,
      "title": "Best Lap \u2014 ${driver_acronym}",
      "description": "Single fastest lap time of the session and the driver who set it.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT concat('${driver_acronym} \u2014 ', toString(round(min(lap_duration),3)), 's') AS fastest_lap\n       FROM default.fct_laps\n       WHERE session_key = ${session_key}\n         AND name_acronym = '${driver_acronym}'\n         AND lap_duration IS NOT NULL AND is_pit_out_lap = 0",
          "refId": "A",
          "meta": {
            "builderOptions": {
              "queryType": "table",
