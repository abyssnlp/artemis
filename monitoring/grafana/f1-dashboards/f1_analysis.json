          }
        ]
      }
    },
    {
      "id": 401,
      "title": "Tyre Degradation \u2014 ${driver_acronym} (pace vs tyre age)",
      "description": "Average lap time at each tyre age, grouped by compound. Reveals the actual cliff: where each compound starts losing seconds. Steeper rise = faster degradation. Flat = consistent.",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT tyre_age,\n              avgIf(lap_duration, compound = 'SOFT')         AS SOFT,\n              avgIf(lap_duration, compound = 'MEDIUM')       AS MEDIUM,\n              avgIf(lap_duration, compound = 'HARD')         AS HARD,\n              avgIf(lap_duration, compound = 'INTERMEDIATE') AS INTERMEDIATE,\n              avgIf(lap_duration, compound = 'WET')          AS WET\n         FROM default.fct_laps\n         WHERE session_key = ${session_key}\n           AND name_acronym = '${driver_acronym}'\n           AND lap_duration IS NOT NULL AND is_pit_out_lap = 0 AND tyre_age < 50\n         GROUP BY tyre_age ORDER BY tyre_age",
          "refId": "A",
          "meta": {
            "builderOptions": {
              "queryType": "table",
              "database": "default",
              "table": "fct_laps"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
