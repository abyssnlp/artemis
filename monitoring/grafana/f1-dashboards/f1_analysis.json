    {
      "id": 201,
      "title": "Race Trace: ${driver_acronym} Gap to Leader",
      "description": "Cumulative race time minus the leader's cumulative race time at every lap. Lower = closer to the front. Sharp upward spikes are pit stops; slow climbs reveal pace deficits.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "format": 2,
          "queryType": "sql",
          "rawSql": "WITH cum AS (\n         SELECT driver_number, name_acronym, lap_number, date_start,\n                sum(lap_duration) OVER (PARTITION BY driver_number ORDER BY lap_number) AS cum_time\n         FROM default.fct_laps\n         WHERE session_key = ${session_key} AND lap_duration IS NOT NULL\n       ),\n       leader AS (\n         SELECT lap_number, min(cum_time) AS leader_time FROM cum GROUP BY lap_number\n       )\n       SELECT cum.date_start AS time,\n              cum.cum_time - leader.leader_time AS gap,\n              cum.name_acronym AS metric\n       FROM cum\n       LEFT JOIN leader ON cum.lap_number = leader.lap_number\n       WHERE cum.name_acronym = '${driver_acronym}'\n       ORDER BY time",
          "refId": "A",
          "meta": {
            "builderOptions": {
              "queryType": "table",
              "database": "default",
              "table": "fct_laps"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": true,
            "fillOpacity": 0,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Gap to leader (s)",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "last"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      }
    },
    {
      "id": 301,
      "title": "Stint Strategy \u2014 ${driver_acronym}",
      "type": "table",
      "description": "Compound, lap range, length and average pace for every stint of every driver. Cells coloured by tyre compound. Reads strategy at a glance: 1-stop vs 2-stop vs aggressive multi-stop, and which compound delivered which pace.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT name_acronym AS Driver,\n                  stint_number  AS Stint,\n                  compound      AS Compound,\n                  min(lap_number) AS LapStart,\n                  max(lap_number) AS LapEnd,\n                  count()         AS Laps,\n                  round(avg(lap_duration), 3) AS AvgPace,\n                  round(min(lap_duration), 3) AS BestLap\n           FROM default.fct_laps\n           WHERE session_key = ${session_key}\n             AND name_acronym = '${driver_acronym}'\n             AND is_pit_out_lap = 0 AND lap_duration IS NOT NULL\n           GROUP BY name_acronym, driver_number, stint_number, compound\n           ORDER BY stint_number ASC",
          "refId": "A",
          "meta": {
            "builderOptions": {
              "queryType": "table",
              "database": "default",
              "table": "fct_laps"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Compound"
            },
            "properties": [
              {
