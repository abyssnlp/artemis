          "format": 2,
          "queryType": "sql",
          "rawSql": "WITH leader_per_lap AS (\n         SELECT lap_number, min(lap_duration) AS leader_lap\n         FROM default.fct_laps\n         WHERE session_key = ${session_key} AND lap_duration IS NOT NULL AND is_pit_out_lap = 0\n         GROUP BY lap_number\n       )\n       SELECT f.date_start AS time,\n              f.lap_duration AS focus_driver,\n              l.leader_lap   AS race_leader_pace\n       FROM default.fct_laps f\n       LEFT JOIN leader_per_lap l ON f.lap_number = l.lap_number\n       WHERE f.session_key = ${session_key}\n         AND f.name_acronym = '${driver_acronym}'\n         AND f.lap_duration IS NOT NULL\n         AND f.is_pit_out_lap = 0\n       ORDER BY time",
